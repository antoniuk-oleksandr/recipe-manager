{
  "name": "recipe-manager-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "pnpm drizzle-kit generate --config=src/config/drizzle/drizzle.config.ts",
    "db:migrate": "pnpm drizzle-kit migrate --config=src/config/drizzle/drizzle.config.ts",
    "db:test:migrate": "dotenv -e .env.test -- pnpm drizzle-kit migrate --config=src/config/drizzle/drizzle.config.ts",
    "compose-down": "docker-compose -f ../infra/dev/docker-compose.yaml down",
    "compose-up": "docker-compose -f ../infra/dev/docker-compose.yaml up -d",
    "docker-build": "docker buildx build -t kawaiinex/recipe-manager-backend .",
    "test": "dotenv -e .env.test -- npx jest --config src/config/jest/jest.config.ts --coverage",
    "test:int": "dotenv -e .env.test -- npx jest --config src/config/jest/jest.int.config.ts --coverage",
    "cov:html": "firefox ./coverage/lcov-report/index.html",
    "docs": "npx ts-node -r tsconfig-paths/register ./scripts/swagger.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@jest/transform": "^30.1.2",
    "@nestjs/class-validator": "^0.13.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
